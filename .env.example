# ShiftGuard SaaS Production Environment Variables Template
# Copy this file to .env or .env.local and fill in production values.
# NEVER commit real production secrets to Git repositories.

# =========================================================================
# 1. Database Configuration (PostgreSQL / Neon / Render / Supabase)
# =========================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/shiftguard?sslmode=require&connect_timeout=30"

# =========================================================================
# 2. Platform Security & Authentication Secrets
# =========================================================================
JWT_SECRET="your-32-character-random-jwt-secret-key"
SESSION_SECRET="your-32-character-random-session-secret-key"

# Platform Super Admin Initial Credentials
SUPER_ADMIN_EMAIL="superadmin@yourdomain.com"
SUPER_ADMIN_PASSWORD="SecureSuperAdminPassword123!"
SUPER_ADMIN_NAME="Platform Super Admin"

# Application Base URL
NEXT_PUBLIC_APP_URL="https://shiftguard.yourdomain.com"
NODE_ENV="production"

# =========================================================================
# 3. Email Service Configuration (Brevo / SMTP)
# =========================================================================
EMAIL_PROVIDER="brevo" # "brevo" | "smtp"

# Brevo Transactional Email API Keys
BREVO_API_KEY="xkeysib-your-primary-brevo-api-key"
BREVO_API_KEY_2="xkeysib-your-secondary-fallback-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="ShiftGuard"

# SMTP Fallback Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="smtp-user@yourdomain.com"
SMTP_PASS="your-smtp-app-password"
SMTP_EMAIL="smtp-user@yourdomain.com"
EMAIL_FROM="ShiftGuard <noreply@yourdomain.com>"

# =========================================================================
# 4. Object Storage Configuration (Cloudflare R2 / AWS S3)
# =========================================================================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="shiftguard-uploads"
R2_PUBLIC_URL="https://uploads.yourdomain.com"
