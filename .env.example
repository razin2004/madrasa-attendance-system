# ===================================================================
# Thandorappara Juma Masjid Madrasa Attendance System
# Sample Environment Configuration Template (.env.example)
# ===================================================================

# Environment Mode: "development" | "production"
ENVIRONMENT=production
DEBUG=False

# Security Secret Key (Generate a random 32-character secret in production)
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Madrasa Identity
MADRASA_NAME="Thandorappara Juma Masjid Madrasa"

# Database Connection URL:
# 1. SQLite (Default for local development):
DATABASE_URL=sqlite:///./thandorappara_madrasa.db

# 2. PostgreSQL (Recommended for production deployment):
# DATABASE_URL=postgresql://madrasa_user:strong_password@localhost:5432/madrasa_attendance

# Authorized Madrasa WiFi Network IPs (Comma-separated list of router IPs)
ALLOWED_WIFI_IPS=127.0.0.1,192.168.1.100

# Initial Super Admin (Management Committee) Credentials
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change_this_superadmin_password_123
SUPERADMIN_NAME="Masjid Management Committee"

# Initial Principal Admin (Sadr Ustadh) Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_principal_password_123
ADMIN_NAME="Principal Sadr Ustadh"
